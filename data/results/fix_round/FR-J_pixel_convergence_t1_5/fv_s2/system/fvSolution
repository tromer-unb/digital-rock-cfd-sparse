FoamFile { version 2.0; format ascii; class dictionary; object fvSolution; }
solvers { p { solver GAMG; smoother GaussSeidel; tolerance 1e-11; relTol 0.001;
    nCellsInCoarsestLevel 50; mergeLevels 1; agglomerator faceAreaPair; cacheAgglomeration true; }
U { solver PBiCGStab; preconditioner DILU; tolerance 1e-12; relTol 0.001; } }
SIMPLE { consistent yes; nNonOrthogonalCorrectors 0;
  residualControl { p 1e-08; U 1e-09; } }
relaxationFactors { equations { U 0.9; } fields { p 1; } }
