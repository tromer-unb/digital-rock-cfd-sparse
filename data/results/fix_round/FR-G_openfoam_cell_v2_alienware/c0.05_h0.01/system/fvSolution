FoamFile { version 2.0; format ascii; class dictionary; object fvSolution; }
solvers { p { solver GAMG; smoother GaussSeidel; tolerance 1e-12; relTol 0.01; }
U { solver smoothSolver; smoother symGaussSeidel; tolerance 1e-14; relTol 0.01; } }
SIMPLE { consistent yes; nNonOrthogonalCorrectors 1; pRefCell 0; pRefValue 0;
  residualControl { p 1e-10; U 1e-11; } }
relaxationFactors { equations { U 0.9; } fields { p 1; } }
