FoamFile
{
    version     2.0;
    format      ascii;
    class       polyBoundaryMesh;
    location    "constant/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

6
(
    frontAndBack
    {
        type            empty;
        physicalType    patch;
        inGroups        1(empty);
        nFaces          46400;
        startFace       46000;
    }
    cylinder
    {
        type            wall;
        physicalType    patch;
        inGroups        1(wall);
        nFaces          400;
        startFace       92400;
    }
    left_c
    {
        type            cyclic;
        inGroups        1(cyclic);
        nFaces          100;
        startFace       92800;
        matchTolerance  1e-06;
        transform       translational;
        neighbourPatch  right_c;
        separationVector (1 0 0);
    }
    right_c
    {
        type            cyclic;
        inGroups        1(cyclic);
        nFaces          100;
        startFace       92900;
        matchTolerance  1e-06;
        transform       translational;
        neighbourPatch  left_c;
        separationVector (-1 0 0);
    }
    bottom_c
    {
        type            cyclic;
        inGroups        1(cyclic);
        nFaces          100;
        startFace       93000;
        matchTolerance  1e-06;
        transform       translational;
        neighbourPatch  top_c;
        separationVector (0 1 0);
    }
    top_c
    {
        type            cyclic;
        inGroups        1(cyclic);
        nFaces          100;
        startFace       93100;
        matchTolerance  1e-06;
        transform       translational;
        neighbourPatch  bottom_c;
        separationVector (0 -1 0);
    }
)

